{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1300,
      "height": 600
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "domId": "comingsoon-root"
    },
    "props": {
      "direction": "column",
      "justify": "center",
      "alignItems": "center",
      "style": {
        "backgroundColor": "var(--tai-bg)",
        "padding": "60px 32px",
        "minHeight": "480px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "panel"
        },
        "props": {
          "direction": "column",
          "gap": 14,
          "alignItems": "center",
          "style": {
            "backgroundColor": "var(--tai-surface)",
            "border": "1px solid var(--tai-border)",
            "borderRadius": "var(--tai-radius)",
            "boxShadow": "var(--tai-shadow-card)",
            "padding": "40px 56px",
            "maxWidth": "520px"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "iconbox"
            },
            "props": {
              "direction": "column",
              "justify": "center",
              "alignItems": "center",
              "style": {
                "backgroundColor": "var(--tai-accent-soft)",
                "borderRadius": "14px",
                "width": "56px",
                "height": "56px"
              }
            },
            "children": [
              {
                "type": "ia.display.icon",
                "meta": {
                  "name": "icon"
                },
                "props": {
                  "path": "material/construction",
                  "color": "var(--tai-accent)",
                  "style": {
                    "width": "30px",
                    "height": "30px"
                  }
                }
              }
            ],
            "position": {
              "shrink": 0,
              "basis": "56px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "props": {
              "text": "This module is in development",
              "style": {
                "fontWeight": "700",
                "fontSize": "20px",
                "color": "var(--tai-text)",
                "textAlign": "center"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "sub"
            },
            "props": {
              "text": "This area is part of the migration roadmap and will be available in a later release. Use Home to return to an active module.",
              "style": {
                "fontSize": "13.5px",
                "color": "var(--tai-text-muted)",
                "textAlign": "center",
                "lineHeight": "1.5"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "homeBtn",
              "domId": "comingsoon-home"
            },
            "props": {
              "direction": "row",
              "gap": 6,
              "alignItems": "center",
              "justify": "center",
              "style": {
                "cursor": "pointer",
                "backgroundColor": "var(--tai-accent)",
                "borderRadius": "var(--tai-radius-control)",
                "padding": "9px 18px",
                "marginTop": "6px"
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.navigate('/home')\n"
                  }
                }
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "homeBtnText"
                },
                "props": {
                  "text": "Back to Home",
                  "style": {
                    "fontSize": "13px",
                    "fontWeight": "600",
                    "color": "var(--tai-on-accent)",
                    "whiteSpace": "nowrap"
                  }
                }
              }
            ],
            "position": {
              "shrink": 0,
              "basis": "auto"
            }
          }
        ],
        "position": {
          "shrink": 0,
          "basis": "auto"
        }
      }
    ]
  }
}
