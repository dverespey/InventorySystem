  "params": {
    "recordId": 0
  },
  "propConfig": {
    "custom.recordId": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.params.recordId"
        }
      },
      "onChange": {
        "scope": "G",
        "script": "\t# ---- Supplier Detail: recordId change -> load (DEFECT FIX, design §A.3) ----\n\t# The List onRowClick navigate(view=...,params={recordId:N}) swaps the primary\n\t# view in place; the fresh instance's onStartup does NOT re-fire the parameterized\n\t# load. custom.recordId is bound to view.params.recordId, so this change script\n\t# fires when the navigated id resolves. We read v.params.recordId fresh (the\n\t# binding source) rather than trusting the coalesced currentValue. onStartup still\n\t# seeds the recordId=0 insert-mode case. IG81-COMPAT: plain change script + T-SQL,\n\t# identical on 8.1.52 and 8.3.\n\tlog = system.util.getLogger(\"SPIKE\")\n\t# self == the view that owns custom.recordId; resolve its custom/params robustly\n\t# (view event scripts expose self.view; a property change script's self IS the view).\n\tv = self.view if hasattr(self, \"view\") else self\n\tDB = \"Inventory_Spike\"\n\tc = v.custom\n\tcv = getattr(currentValue, \"value\", currentValue)\n\t# prefer the freshest authoritative source: the input param itself.\n\tpr = v.params.recordId\n\trecId = int((pr if pr not in (None, \"\") else cv) or 0)\n\tlog.info(\"SPIKE Supplier Detail recordId onChange fired: recId=%s origin=%s\" % (recId, origin))\n\tsiteId = int(c.siteId or 1)   # IG-SITE: plumbed; predicate commented (D1)\n\n\t# ---- FK combo options (lookups/logistics, lookups/partType) ----\n\tlogDs = system.db.runPrepQuery(\"SELECT IN_LOGISTICS_ID AS id, VC_LOGISTICS_NAME AS label FROM INV_LOGISTICS_MST /* IG-SITE: WHERE site_id = ? */ ORDER BY VC_LOGISTICS_NAME\", [], DB)\n\tc.logisticsOptions = [{\"value\": logDs.getValueAt(i, \"id\"), \"label\": logDs.getValueAt(i, \"label\")} for i in xrange(logDs.rowCount)]\n\tptDs = system.db.runPrepQuery(\"SELECT VC_PART_TYPE AS id, VC_PART_TYPE AS label FROM INV_PART_TYPE_MST /* IG-SITE: WHERE site_id = ? */ ORDER BY VC_PART_TYPE\", [], DB)\n\tc.partTypeOptions = [{\"value\": ptDs.getValueAt(i, \"id\"), \"label\": ptDs.getValueAt(i, \"label\")} for i in xrange(ptDs.rowCount)]\n\tlog.info(\"SPIKE Supplier Detail combos: logistics=%d partType=%d\" % (logDs.rowCount, ptDs.rowCount))\n\n\tif recId <= 0:\n\t\tc.statusMsg = \"New supplier — enter details and Save.\"\n\t\tlog.info(\"SPIKE Supplier Detail: insert mode (recordId=0)\")\n\t\treturn\n\n\t# ---- edit mode: Supplier/get ----\n\tgetSql = (\"SELECT s.VC_SUPPLIER_CODE, s.VC_SUPPLIER_NAME, s.VC_ADDRESS, s.VC_CITY, s.VC_STATE, \"\n\t          \"s.VC_ZIP, s.VC_COUNTRY, s.VC_TEL, s.VC_FAX, s.VC_PERSON, s.VC_EMAIL_ADDRESS, \"\n\t          \"s.VC_BREAKDOWN_ORDER_DIRECTORY, s.IN_LOGISTICS_ID, l.VC_LOGISTICS_NAME, \"\n\t          \"s.VC_OUTPUT_FILE, s.BIT_ORDER_FILE_TIMESTAMP, s.BIT_SITE_NUMBER_IN_ORDER, \"\n\t          \"s.VC_CREATE_ORDER_SHEET, s.VC_INVENTORY_ADD_POINT \"\n\t          \"FROM INV_SUPPLIER_MST s LEFT OUTER JOIN INV_LOGISTICS_MST l ON s.IN_LOGISTICS_ID = l.IN_LOGISTICS_ID \"\n\t          \"WHERE s.IN_SUPPLIER_ID = ? -- IG-SITE: AND s.site_id = ?\")\n\tds = system.db.runPrepQuery(getSql, [recId], DB)\n\tif ds.rowCount == 0:\n\t\tc.statusMsg = \"Supplier id %d not found.\" % recId\n\t\tlog.warn(\"SPIKE Supplier Detail: id %d not found\" % recId); return\n\tdef g(col):\n\t\tval = ds.getValueAt(0, col)\n\t\treturn val if val is not None else \"\"\n\tc.form_code = g(\"VC_SUPPLIER_CODE\"); c.form_name = g(\"VC_SUPPLIER_NAME\")\n\tc.form_address = g(\"VC_ADDRESS\"); c.form_city = g(\"VC_CITY\"); c.form_state = g(\"VC_STATE\")\n\tc.form_zip = g(\"VC_ZIP\"); c.form_country = g(\"VC_COUNTRY\"); c.form_tel = g(\"VC_TEL\")\n\tc.form_fax = g(\"VC_FAX\"); c.form_person = g(\"VC_PERSON\"); c.form_email = g(\"VC_EMAIL_ADDRESS\")\n\tc.form_directory = g(\"VC_BREAKDOWN_ORDER_DIRECTORY\")\n\tlid = ds.getValueAt(0, \"IN_LOGISTICS_ID\")\n\tc.form_logisticsId = int(lid) if lid is not None else None\n\tc.form_outputFile = g(\"VC_OUTPUT_FILE\") or \"T\"\n\tc.form_orderFileTimestamp = bool(ds.getValueAt(0, \"BIT_ORDER_FILE_TIMESTAMP\"))\n\tc.form_siteNumberInOrder = bool(ds.getValueAt(0, \"BIT_SITE_NUMBER_IN_ORDER\"))\n\tc.form_createOrderSheet = g(\"VC_CREATE_ORDER_SHEET\")\n\tc.form_invAddPoint = g(\"VC_INVENTORY_ADD_POINT\") or \"S\"\n\tc.statusMsg = \"Editing supplier %s (id %d).\" % (c.form_code, recId)\n\tlog.info(\"SPIKE Supplier Detail loaded id=%d code=%s logId=%s\" % (recId, c.form_code, c.form_logisticsId))\n"
      }
    }
  },
