      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ActionBar"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "gap": "12px",
            "padding": "8px 0"
          }
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "SaveButton",
              "domId": "supplier-save-btn"
            },
            "props": {
              "text": "Save",
              "style": {
                "backgroundColor": "#1976D2",
                "color": "#FFFFFF",
                "fontWeight": "bold"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# ---- Supplier Save (insert-or-update) — §B.3/B.4 ----\n\t# Mechanism: inline runPrepQuery of the canonical Supplier/insert|update|checkCodeUnique\n\t# SQL (master-crud-namedqueries.sql). recordId==0 -> insert; >0 -> update.\n\tlog = system.util.getLogger(\"SPIKE\")\n\tDB = \"Inventory_Spike\"\n\tc = self.view.custom\n\trecId = int(c.recordId or 0)\n\tsiteId = int(c.siteId or 1)   # IG-SITE: plumbed; predicate commented (D1)\n\n\tcode = (c.form_code or \"\").strip()\n\tname = (c.form_name or \"\").strip()\n\tinvAdd = (c.form_invAddPoint or \"\").strip()\n\n\t# ---- B.4 validation (client-side fast-fail; DB unique index is the backstop) ----\n\tif len(code) != 5:\n\t\tc.statusMsg = \"Supplier code must be exactly 5 characters.\"\n\t\tlog.info(\"SPIKE Supplier save REJECTED: code len=%d\" % len(code)); return\n\tif name == \"\":\n\t\tc.statusMsg = \"Supplier name is required.\"\n\t\tlog.info(\"SPIKE Supplier save REJECTED: blank name\"); return\n\tif invAdd not in (\"S\", \"A\"):\n\t\tc.statusMsg = \"Inventory Add Point is required (S or A).\"\n\t\tlog.info(\"SPIKE Supplier save REJECTED: invAddPoint=%r\" % invAdd); return\n\n\t# per-site uniqueness pre-check (checkCodeUnique). excludeId=recordId on update, 0 on insert.\n\t# IG-SITE: site_id predicate commented; siteId plumbed but not a positional arg today.\n\texcludeId = recId if recId > 0 else 0\n\tchkSql = (\"SELECT COUNT(*) AS n FROM INV_SUPPLIER_MST \"\n\t          \"WHERE VC_SUPPLIER_CODE = ? AND IN_SUPPLIER_ID <> ? \"\n\t          \"-- IG-SITE: AND site_id = ?\")\n\tdup = system.db.runPrepQuery(chkSql, [code, excludeId], DB)\n\tif dup.rowCount > 0 and int(dup.getValueAt(0, 0)) > 0:\n\t\tc.statusMsg = \"Supplier code already exists.\"\n\t\tlog.info(\"SPIKE Supplier save REJECTED: dup code=%s\" % code); return\n\n\t# ---- coerce form -> column values ----\n\tdef s(v):\n\t\treturn (v if v is not None else \"\")\n\tlogId = c.form_logisticsId\n\tif logId in (None, \"\", 0):\n\t\tlogId = None   # blank Logistics -> NULL (legacy behavior, §A.6)\n\telse:\n\t\tlogId = int(logId)\n\tbitTs = 1 if c.form_orderFileTimestamp else 0\n\tbitSn = 1 if c.form_siteNumberInOrder else 0\n\taudit = (\"CONVERT(char(8),GETDATE(),112) \"\n\t         \"+ SUBSTRING(CONVERT(varchar,GETDATE(),114),1,2) + SUBSTRING(CONVERT(varchar,GETDATE(),114),4,2) \"\n\t         \"+ SUBSTRING(CONVERT(varchar,GETDATE(),114),7,2) + SUBSTRING(CONVERT(varchar,GETDATE(),114),10,2)\")\n\n\tdataArgs = [code, name, s(c.form_address), s(c.form_city), s(c.form_state), s(c.form_zip),\n\t            s(c.form_country), s(c.form_tel), s(c.form_fax), s(c.form_person), s(c.form_email),\n\t            s(c.form_directory), logId, s(c.form_outputFile), bitTs, bitSn,\n\t            s(c.form_createOrderSheet), invAdd]\n\n\ttry:\n\t\tif recId == 0:\n\t\t\t# ---- INSERT (returns SCOPE_IDENTITY) ----\n\t\t\tinsSql = (\"INSERT INTO INV_SUPPLIER_MST \"\n\t\t\t          \"(VC_SUPPLIER_CODE, VC_SUPPLIER_NAME, VC_ADDRESS, VC_CITY, VC_STATE, VC_ZIP, VC_COUNTRY, \"\n\t\t\t          \" VC_TEL, VC_FAX, VC_PERSON, VC_EMAIL_ADDRESS, VC_BREAKDOWN_ORDER_DIRECTORY, \"\n\t\t\t          \" IN_LOGISTICS_ID, VC_OUTPUT_FILE, BIT_ORDER_FILE_TIMESTAMP, BIT_SITE_NUMBER_IN_ORDER, \"\n\t\t\t          \" VC_CREATE_ORDER_SHEET, VC_INVENTORY_ADD_POINT, VC_ADD) \"\n\t\t\t          \"VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?, \" + audit + \"); \"\n\t\t\t          \"SELECT CAST(SCOPE_IDENTITY() AS int) AS newId\")\n\t\t\trs = system.db.runPrepQuery(insSql, dataArgs, DB)\n\t\t\tnewId = int(rs.getValueAt(0, 0))\n\t\t\tself.view.params.recordId = newId   # flip to edit mode (improvement: legacy never echoed id)\n\t\t\tc.statusMsg = \"Inserted supplier %s (id %d).\" % (code, newId)\n\t\t\tlog.info(\"SPIKE Supplier INSERT ok: code=%s newId=%d\" % (code, newId))\n\t\telse:\n\t\t\t# ---- UPDATE (keyed on surrogate id, D2; rename-safe) ----\n\t\t\tupdSql = (\"UPDATE INV_SUPPLIER_MST SET \"\n\t\t\t          \"VC_SUPPLIER_CODE=?, VC_SUPPLIER_NAME=?, VC_ADDRESS=?, VC_CITY=?, VC_STATE=?, VC_ZIP=?, \"\n\t\t\t          \"VC_COUNTRY=?, VC_TEL=?, VC_FAX=?, VC_PERSON=?, VC_EMAIL_ADDRESS=?, \"\n\t\t\t          \"VC_BREAKDOWN_ORDER_DIRECTORY=?, IN_LOGISTICS_ID=?, VC_OUTPUT_FILE=?, \"\n\t\t\t          \"BIT_ORDER_FILE_TIMESTAMP=?, BIT_SITE_NUMBER_IN_ORDER=?, VC_CREATE_ORDER_SHEET=?, \"\n\t\t\t          \"VC_INVENTORY_ADD_POINT=?, VC_LASTUPDATE = \" + audit + \" \"\n\t\t\t          \"WHERE IN_SUPPLIER_ID = ? \"\n\t\t\t          \"-- IG-SITE: AND site_id = ?\")\n\t\t\tn = system.db.runPrepUpdate(updSql, dataArgs + [recId], DB)\n\t\t\tc.statusMsg = \"Updated supplier %s (%d row).\" % (code, n)\n\t\t\tlog.info(\"SPIKE Supplier UPDATE ok: id=%d code=%s rows=%d\" % (recId, code, n))\n\texcept Exception, e:\n\t\t# race backstop: the live IX_INV_SUPPLIER_MST unique index. Surface the friendly msg.\n\t\tmsg = unicode(e)\n\t\tif \"IX_INV_SUPPLIER_MST\" in msg or \"duplicate key\" in msg.lower() or \"UNIQUE\" in msg.upper():\n\t\t\tc.statusMsg = \"Supplier code already exists.\"\n\t\t\tlog.info(\"SPIKE Supplier save: unique-index backstop fired for code=%s\" % code)\n\t\telse:\n\t\t\tc.statusMsg = \"Save failed: %s\" % msg\n\t\t\tlog.warn(\"SPIKE Supplier save FAILED: %s\" % msg)\n"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "DeleteButton",
              "domId": "supplier-delete-btn"
            },
            "props": {
              "text": "Delete",
              "style": {
                "backgroundColor": "#C62828",
                "color": "#FFFFFF",
                "fontWeight": "bold"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# ---- Supplier Delete — D3 RESTRICT gate (R1-critical), §B.5 ----\n\t# refCount counts ALL THREE tables the live DELETE_SupplierCode trigger touches:\n\t#   parts (by IN_SUPPLIER_ID) + INV_BREAKDOWN_FC_INF + INV_FORECAST_INF (both by code).\n\t# Block on any non-zero total; NEVER let a delete reach the trigger while refs exist\n\t# (the trigger cascade-deletes forecast history — the data-loss path).\n\tlog = system.util.getLogger(\"SPIKE\")\n\tDB = \"Inventory_Spike\"\n\tc = self.view.custom\n\trecId = int(c.recordId or 0)\n\tcode = (c.form_code or \"\").strip()\n\tif recId == 0:\n\t\tc.statusMsg = \"Nothing to delete (unsaved new record).\"\n\t\treturn\n\trefSql = (\"SELECT \"\n\t          \"  (SELECT COUNT(*) FROM INV_PARTS_STOCK_MST  WHERE IN_SUPPLIER_ID   = ?) \"\n\t          \"+ (SELECT COUNT(*) FROM INV_BREAKDOWN_FC_INF WHERE VC_SUPPLIER_CODE = ?) \"\n\t          \"+ (SELECT COUNT(*) FROM INV_FORECAST_INF     WHERE VC_SUPPLIER_CODE = ?) AS n\")\n\trs = system.db.runPrepQuery(refSql, [recId, code, code], DB)\n\tn = int(rs.getValueAt(0, 0))\n\tlog.info(\"SPIKE Supplier refCount: id=%d code=%s n=%d\" % (recId, code, n))\n\tif n > 0:\n\t\tc.statusMsg = (\"Cannot delete supplier %s — still referenced by %d part(s) / forecast row(s). \"\n\t\t               \"Reassign or archive those rows first.\") % (code, n)\n\t\tlog.info(\"SPIKE Supplier DELETE BLOCKED: id=%d code=%s refs=%d\" % (recId, code, n)); return\n\ttry:\n\t\tdelN = system.db.runPrepUpdate(\"DELETE FROM INV_SUPPLIER_MST WHERE IN_SUPPLIER_ID = ? -- IG-SITE: AND site_id = ?\", [recId], DB)\n\t\tlog.info(\"SPIKE Supplier DELETE ok: id=%d code=%s rows=%d\" % (recId, code, delN))\n\t\tsystem.perspective.navigate(view=\"Master/Supplier/List\")\n\texcept Exception, e:\n\t\tc.statusMsg = \"Delete failed: %s\" % unicode(e)\n\t\tlog.warn(\"SPIKE Supplier DELETE FAILED: %s\" % unicode(e))\n"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "ClearButton",
              "domId": "supplier-clear-btn"
            },
            "props": {
              "text": "Clear",
              "style": {
                "backgroundColor": "#607D8B",
                "color": "#FFFFFF"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# Clear -> reset to a blank insert-mode form (recordId=0).\n\tc = self.view.custom\n\tself.view.params.recordId = 0\n\tc.form_code = \"\"; c.form_name = \"\"; c.form_address = \"\"; c.form_city = \"\"; c.form_state = \"\"\n\tc.form_zip = \"\"; c.form_country = \"\"; c.form_tel = \"\"; c.form_fax = \"\"; c.form_person = \"\"\n\tc.form_email = \"\"; c.form_directory = \"\"; c.form_logisticsId = None\n\tc.form_outputFile = \"T\"; c.form_orderFileTimestamp = False; c.form_siteNumberInOrder = False\n\tc.form_createOrderSheet = \"\"; c.form_invAddPoint = \"S\"\n\tc.statusMsg = \"Cleared — ready for a new supplier.\"\n\tsystem.util.getLogger(\"SPIKE\").info(\"SPIKE Supplier form cleared\")\n"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "BackButton",
              "domId": "supplier-back-btn"
            },
            "props": {
              "text": "Back to List",
              "style": {
                "backgroundColor": "#455A64",
                "color": "#FFFFFF"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.navigate(view=\"Master/Supplier/List\")\n"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  },
  "events": {
    "view": {
      "onStartup": {
        "type": "script",
        "scope": "G",
        "config": {
          "script": "\t# ---- Supplier Detail onStartup — load FK combos + (edit mode) the row ----\n\t# Mechanism: inline runPrepQuery of canonical lookups/* + Supplier/get SQL\n\t# (master-crud-namedqueries.sql). recordId>0 -> edit mode (seed flat form_* props\n\t# in place); recordId==0 -> insert mode (leave pre-declared seed).\n\tlog = system.util.getLogger(\"SPIKE\")\n\tDB = \"Inventory_Spike\"\n\tc = self.view.custom\n\trecId = int(c.recordId or 0)\n\tsiteId = int(c.siteId or 1)   # IG-SITE: plumbed; predicate commented (D1)\n\n\t# ---- FK combo options (lookups/logistics, lookups/partType) ----\n\t# IG-SITE: WHERE site_id = ? predicate commented; siteId not a positional arg today.\n\tlogDs = system.db.runPrepQuery(\"SELECT IN_LOGISTICS_ID AS id, VC_LOGISTICS_NAME AS label FROM INV_LOGISTICS_MST /* IG-SITE: WHERE site_id = ? */ ORDER BY VC_LOGISTICS_NAME\", [], DB)\n\tc.logisticsOptions = [{\"value\": logDs.getValueAt(i, \"id\"), \"label\": logDs.getValueAt(i, \"label\")} for i in xrange(logDs.rowCount)]\n\tptDs = system.db.runPrepQuery(\"SELECT VC_PART_TYPE AS id, VC_PART_TYPE AS label FROM INV_PART_TYPE_MST /* IG-SITE: WHERE site_id = ? */ ORDER BY VC_PART_TYPE\", [], DB)\n\tc.partTypeOptions = [{\"value\": ptDs.getValueAt(i, \"id\"), \"label\": ptDs.getValueAt(i, \"label\")} for i in xrange(ptDs.rowCount)]\n\tlog.info(\"SPIKE Supplier Detail combos: logistics=%d partType=%d\" % (logDs.rowCount, ptDs.rowCount))\n\n\tif recId <= 0:\n\t\tc.statusMsg = \"New supplier — enter details and Save.\"\n\t\tlog.info(\"SPIKE Supplier Detail: insert mode (recordId=0)\")\n\t\treturn\n\n\t# ---- edit mode: Supplier/get ----\n\tgetSql = (\"SELECT s.VC_SUPPLIER_CODE, s.VC_SUPPLIER_NAME, s.VC_ADDRESS, s.VC_CITY, s.VC_STATE, \"\n\t          \"s.VC_ZIP, s.VC_COUNTRY, s.VC_TEL, s.VC_FAX, s.VC_PERSON, s.VC_EMAIL_ADDRESS, \"\n\t          \"s.VC_BREAKDOWN_ORDER_DIRECTORY, s.IN_LOGISTICS_ID, l.VC_LOGISTICS_NAME, \"\n\t          \"s.VC_OUTPUT_FILE, s.BIT_ORDER_FILE_TIMESTAMP, s.BIT_SITE_NUMBER_IN_ORDER, \"\n\t          \"s.VC_CREATE_ORDER_SHEET, s.VC_INVENTORY_ADD_POINT \"\n\t          \"FROM INV_SUPPLIER_MST s LEFT OUTER JOIN INV_LOGISTICS_MST l ON s.IN_LOGISTICS_ID = l.IN_LOGISTICS_ID \"\n\t          \"WHERE s.IN_SUPPLIER_ID = ? -- IG-SITE: AND s.site_id = ?\")\n\tds = system.db.runPrepQuery(getSql, [recId], DB)\n\tif ds.rowCount == 0:\n\t\tc.statusMsg = \"Supplier id %d not found.\" % recId\n\t\tlog.warn(\"SPIKE Supplier Detail: id %d not found\" % recId); return\n\tdef g(col):\n\t\tv = ds.getValueAt(0, col)\n\t\treturn v if v is not None else \"\"\n\tc.form_code = g(\"VC_SUPPLIER_CODE\"); c.form_name = g(\"VC_SUPPLIER_NAME\")\n\tc.form_address = g(\"VC_ADDRESS\"); c.form_city = g(\"VC_CITY\"); c.form_state = g(\"VC_STATE\")\n\tc.form_zip = g(\"VC_ZIP\"); c.form_country = g(\"VC_COUNTRY\"); c.form_tel = g(\"VC_TEL\")\n\tc.form_fax = g(\"VC_FAX\"); c.form_person = g(\"VC_PERSON\"); c.form_email = g(\"VC_EMAIL_ADDRESS\")\n\tc.form_directory = g(\"VC_BREAKDOWN_ORDER_DIRECTORY\")\n\tlid = ds.getValueAt(0, \"IN_LOGISTICS_ID\")\n\tc.form_logisticsId = int(lid) if lid is not None else None\n\tc.form_outputFile = g(\"VC_OUTPUT_FILE\") or \"T\"\n\tc.form_orderFileTimestamp = bool(ds.getValueAt(0, \"BIT_ORDER_FILE_TIMESTAMP\"))\n\tc.form_siteNumberInOrder = bool(ds.getValueAt(0, \"BIT_SITE_NUMBER_IN_ORDER\"))\n\tc.form_createOrderSheet = g(\"VC_CREATE_ORDER_SHEET\")\n\tc.form_invAddPoint = g(\"VC_INVENTORY_ADD_POINT\") or \"S\"\n\tc.statusMsg = \"Editing supplier %s (id %d).\" % (c.form_code, recId)\n\tlog.info(\"SPIKE Supplier Detail loaded id=%d code=%s logId=%s\" % (recId, c.form_code, c.form_logisticsId))\n"
        }
      }
    }
  }
}
