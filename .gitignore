DB Schema/InventoryBU.sql
Database/FullInventory

# ---------------------------------------------------------------------------
# Delphi / Object Pascal build outputs
# ---------------------------------------------------------------------------
# compiled units / packages / binaries
*.dcu
*.dcp
*.bpl
*.exe
*.dll
*.ocx
*.obj
*.o
*.a
*.lib
# debug symbols / linker map
*.tds
*.map
*.rsm
*.drc
*.stat
*.local
*.identcache
*.projdata
*.tvsconfig
__history/
__recovery/

# Delphi editor / IDE backup files (~ prefixed)
*.~*
*.~pas
*.~dfm
*.~dpr
*.~ddp
*.~dof

# Designer diagram / desktop / option state (regenerated by the IDE)
*.ddp
*.dsk

# ---------------------------------------------------------------------------
# Environment / secrets  (contain DB connection strings + passwords)
# ---------------------------------------------------------------------------
InventorySystem.INI
InventorySystem*.INI
forecast.ini

# ---------------------------------------------------------------------------
# OS / editor junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.bak
*.tmp
*.log

# ---------------------------------------------------------------------------
# Client data exports (real plant data — NEVER commit)
# ---------------------------------------------------------------------------
DB Schema/OrderSimulation*.xls
DB Schema/*.bak
DB Schema/DailyWorkLog*.csv
DB Schema/AllLog.csv
DB Schema/ReportLog.csv
# Real TEMA EDI traffic (830/810/856/…) — never commit
EDI/*.EDI
EDIIn/*.EDI
EDIIn/Archive/

# ---------------------------------------------------------------------------
# Stray copies / archives that should not be versioned
# ---------------------------------------------------------------------------
Archive/
Copy of CAMEX System/

# E2E harness: never commit gateway creds or render artifacts
scripts/e2e/.env
scripts/e2e/artifacts/
__pycache__/
*.pyc
# Jython build artifacts (headless POI render runs via the bundled jython; these are throwaway)
.jython_cache/
*$py.class

# Local dev-sandbox bring-up script — carries the throwaway SQL Server sa cred
scripts/spike-db.sh
